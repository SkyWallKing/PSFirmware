<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget pequeno e baixo (ex.: 2x1 estreito): só cabe um número, e a prioridade é a versão MÍNIMA.
  Horizontal para o número usar toda a altura; bolinha de status e botão ficam à direita.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_small"
    android:clipToOutline="true"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-8dp"
        android:alpha="0.13"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_playstation" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Escondido quando o widget é baixo demais (FirmwareWidget). Tamanho automático em vez de "…". -->
            <TextView
                android:id="@+id/label_minimum"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeMinTextSize="5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/value_minimum"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="44sp"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Escondida quando o widget é estreito demais (FirmwareWidget). -->
        <TextView
            android:id="@+id/status_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="●"
            android:textSize="9sp" />

        <!-- Escondido quando o widget é estreito demais (FirmwareWidget). -->
        <ImageView
            android:id="@+id/button_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:alpha="0.8"
            android:contentDescription="@string/refresh_now"
            android:padding="5dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- Presentes para reaproveitar o preenchimento (CardTexts.applyTo). -->
    <TextView
        android:id="@+id/label_latest"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/value_latest"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/value_status"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/value_updated"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/label_card_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
